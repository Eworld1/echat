# ---- Server (Node / Express) ----
PORT=3000
MAX_REEL_SIZE_MB=2
# Comma-separated list of allowed browser origins, or * for any.
# In production set this to your Vercel URL, e.g. https://echat.vercel.app
CORS_ORIGIN=https://echat-ivory.vercel.app
# Admin account. Set a setup password so nobody can claim the admin email before you.
ADMIN_EMAIL=eldermoses89@gmail.com
ADMIN_BOOTSTRAP_PASSWORD=
# Configure the developer identity for Go Live bypass. Set both server and Vite values in production.
SUPER_ADMIN_UID=
SUPER_ADMIN_EMAIL=eldermoses89@gmail.com
# Twilio Network Traversal Service. Keep these server-only; the server creates short-lived TURN credentials.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# MongoDB connection string (free MongoDB Atlas M0). With it, data survives restarts and redeploys.
# Leave empty to use the local JSON file only.
MONGO_URI=
# Dev only: return password-reset codes in the API response (insecure in production)
ALLOW_RESET_TOKEN_IN_RESPONSE=false

# ---- Frontend (Vite) ----
# Base URL of the Echat API/WebSocket server. Leave empty to use the same origin.
# Local:      http://localhost:3000
# Production: set this to the backend host URL (no trailing slash)
VITE_API_URL=http://localhost:3000
VITE_SOCKET_URL=http://localhost:3000
VITE_SUPER_ADMIN_UID=
VITE_SUPER_ADMIN_EMAIL=eldermoses89@gmail.com
# Events tickets: Orange Money / Africell Money number buyers pay to (shown in the Buy Ticket form).
# Empty = "Contact EChat for number". Vite only exposes VITE_* variables (NEXT_PUBLIC_* is not read).
VITE_ECHAT_PAYMENT_NUMBER=

# Optional TURN relay for calls across strict NATs / mobile carriers
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# ---- Firebase client config ----
# Set FIREBASE_PROJECT_ID on the server to the same project used by VITE_FIREBASE_PROJECT_ID.
FIREBASE_PROJECT_ID=echat-studio-6e215
FIREBASE_DATABASE_ID=ai-studio-echat-134f096e-b18d-4bb7-870d-d4f7fa96d17d
# Optional Firebase Admin service account JSON (server-side only). Set this in Render/Vercel
# only if Firestore profile sync and Auth account-creation metadata are needed. Without it,
# Admin SDK imports are skipped and Application Default Credentials are never attempted.
FIREBASE_SERVICE_ACCOUNT_JSON=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_DATABASE_ID=

# ---- Go Live (set in Vercel → Project → Settings → Environment Variables, then redeploy) ----
# LiveKit server credentials (server-side only; NEVER add these to VITE_* variables).
# From LiveKit Cloud → your project → Settings → API Keys.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Go Live also needs FIREBASE_SERVICE_ACCOUNT_JSON (above) on Vercel: live streams, stream keys,
# viewer counts and hearts are stored in Firestore by the server.
# LiveKit webhook (needed for Streaming Software lives to appear/end automatically and for viewer cleanup):
# LiveKit Cloud → Settings → Webhooks → add  https://<your-vercel-domain>/api/live/webhook
# (signed with the API key above; no extra variable needed).
