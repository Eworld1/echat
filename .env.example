# ---- Server (Node / Express) ----
PORT=3000
# Comma-separated list of allowed browser origins, or * for any.
# In production set this to your Vercel URL, e.g. https://echat.vercel.app
CORS_ORIGIN=*
# Admin account. Set a setup password so nobody can claim the admin email before you.
ADMIN_EMAIL=eldermoses89@gmail.com
ADMIN_BOOTSTRAP_PASSWORD=
# Dev only: return password-reset codes in the API response (insecure in production)
ALLOW_RESET_TOKEN_IN_RESPONSE=false

# ---- Frontend (Vite) ----
# Base URL of the Echat API/WebSocket server. Leave empty to use the same origin.
# Local:      http://localhost:3000
# Production: https://your-backend.onrender.com   (no trailing slash)
VITE_API_URL=http://localhost:3000

# Optional TURN relay for calls across strict NATs / mobile carriers
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# ---- Firebase client config ----
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_DATABASE_ID=
