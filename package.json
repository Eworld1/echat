{
  "name": "echat",
  "private": true,
  "version": "1.0.0",
  "description": "Echat - a real-time social chat app (feed, stories, chat, WebRTC calls).",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node --max-old-space-size=8192 --import tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.js",
    "start": "node --max-old-space-size=400 dist/server.js",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^4.3.4",
    "canvas-confetti": "^1.9.4",
    "chess.js": "1.4.0",
    "dotenv": "^17.2.3",
    "emoji-picker-react": "^5.1.4",
    "express": "^4.21.2",
    "firebase": "^13.1.0",
    "firebase-admin": "^14.5.0",
    "html5-qrcode": "^2.3.8",
    "jose": "^6.2.14",
    "livekit-client": "^2.24.0",
    "livekit-server-sdk": "^2.19.3",
    "lucide-react": "^1.73.0",
    "mongoose": "^9.11.4",
    "motion": "^12.23.24",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "vite": "^5.4.14",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/express": "^4.17.21",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.19.0"
  }
}
