rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      let profilePath = /databases/$(database)/documents/users/$(request.auth.uid);
      let profile = exists(profilePath) ? get(profilePath).data : {};
      return signedIn() &&
        (profile.get('role', '') == 'super_admin' ||
          (profile.get('role', '') == 'developer' && profile.get('isOfficialDeveloper', false) == true));
    }

    function isAdmin() {
      return signedIn() && (request.auth.token.email == 'eldermoses89@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') in ['admin', 'super_admin', 'developer']));
    }

    function isBlockedPair(first, second) {
      return exists(/databases/$(database)/documents/blocks/$(first + '_' + second));
    }

    function liveHost(streamId) {
      return get(/databases/$(database)/documents/liveStreams/$(streamId)).data.get('hostId', '');
    }

    function reportCounterUpdate(streamId) {
      let reportPath = /databases/$(database)/documents/reports/$(streamId + '_' + request.auth.uid);
      let nextCount = resource.data.get('reportCount', 0) + 1;
      return signedIn() && existsAfter(reportPath) &&
        getAfter(reportPath).data.get('reporterId', '') == request.auth.uid &&
        getAfter(reportPath).data.get('streamId', '') == streamId &&
        getAfter(reportPath).data.get('targetUserId', '') == resource.data.get('hostId', '') &&
        getAfter(reportPath).data.get('status', '') == 'pending' &&
        request.resource.data.get('reportCount', 0) == nextCount &&
        request.resource.data.get('underReview', false) == (nextCount >= 3) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reportCount', 'underReview']);
    }

    function liveProfile(uid) {
      let profilePath = /databases/$(database)/documents/users/$(uid);
      return exists(profilePath) ? get(profilePath).data : {};
    }

    function canCreateLiveStream(uid) {
      let profile = liveProfile(uid);
      return exists(/databases/$(database)/documents/users/$(uid)) &&
        (profile.get('role', '') == 'super_admin' ||
          (profile.get('role', '') == 'developer' && profile.get('isOfficialDeveloper', false) == true) ||
          (profile.get('isBlocked', false) != true &&
            (profile.get('liveAccess', 'none') == 'approved' ||
              (profile.get('createdAt', 0) is int &&
                profile.get('createdAt', 0) <= request.time.toMillis() - 5184000000))));
    }

    // Preserve the existing access behavior for the app's other collections,
    // while excluding profile security fields and live streams from this broad rule.
    match /{document=**} {
      allow read, write: if document[0] != 'users' && document[0] != 'liveStreams' && document[0] != 'liveRequests' && document[0] != 'followers' && document[0] != 'reports' && document[0] != 'blocks' && document[0] != 'liveTimeouts';
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isSuperAdmin());
      allow delete: if false;
      allow create: if request.auth != null && request.auth.uid == userId &&
        request.resource.data.get('role', 'user') == 'user' &&
        request.resource.data.get('liveAccess', 'none') == 'none' &&
        request.resource.data.get('createdAt', 0) is int &&
        request.resource.data.get('createdAt', 0) >= request.time.toMillis() - 300000 &&
        request.resource.data.get('createdAt', 0) <= request.time.toMillis() + 300000;
      allow update: if request.resource.data.get('role', null) == resource.data.get('role', null) &&
        request.resource.data.get('liveAccess', null) == resource.data.get('liveAccess', null) &&
        request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null) &&
        request.resource.data.get('isOfficialDeveloper', null) == resource.data.get('isOfficialDeveloper', null) &&
        request.resource.data.get('isBlocked', null) == resource.data.get('isBlocked', null) ||
        (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isBlocked', 'liveAccess']));

      match /settings/{settingId} {
        allow read, write: if true;
      }
    }

    match /liveRequests/{requestId} {
      allow create: if signedIn() && request.resource.data.get('userId', '') == request.auth.uid;
      allow read: if signedIn() &&
        (resource.data.get('userId', '') == request.auth.uid || isSuperAdmin());
      allow update, delete: if isSuperAdmin();
    }

    match /liveStreams/{streamId} {
      allow read: if true;
      allow create: if request.auth != null &&
        request.resource.data.get('hostId', '') == request.auth.uid &&
        canCreateLiveStream(request.auth.uid);
      allow update: if request.auth != null &&
        resource.data.get('hostId', '') == request.auth.uid &&
        request.resource.data.get('hostId', '') == resource.data.get('hostId', '') &&
        canCreateLiveStream(request.auth.uid) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['reportCount', 'underReview']) ||
        isAdmin() || reportCounterUpdate(streamId);
      allow delete: if false;

      match /comments/{commentId} {
        function streamIsActive() {
          return get(/databases/$(database)/documents/liveStreams/$(streamId)).data.get('isActive', false) == true;
        }
        function canSeeLiveChat() {
          let host = liveHost(streamId);
          return signedIn() && streamIsActive() && !isBlockedPair(host, request.auth.uid) && !isBlockedPair(request.auth.uid, host);
        }
        allow read: if canSeeLiveChat();
        allow create: if canSeeLiveChat() && request.resource.data.get('userId', '') == request.auth.uid &&
          request.resource.data.get('text', '') is string && request.resource.data.get('text', '').size() > 0 && request.resource.data.get('text', '').size() <= 500 &&
          (!exists(/databases/$(database)/documents/liveTimeouts/$(streamId + '_' + request.auth.uid)) ||
            get(/databases/$(database)/documents/liveTimeouts/$(streamId + '_' + request.auth.uid)).data.get('expiresAt', 0) <= request.time.toMillis());
        allow update: if false;
        allow delete: if signedIn() && (liveHost(streamId) == request.auth.uid || isAdmin());
      }
    }

    match /followers/{followId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.get('followerId', '') == request.auth.uid &&
        request.resource.data.get('followingId', '') != request.auth.uid &&
        followId == request.auth.uid + '_' + request.resource.data.get('followingId', '') &&
        request.resource.data.get('createdAt', 0) is int &&
        !isBlockedPair(request.auth.uid, request.resource.data.get('followingId', '')) &&
        !isBlockedPair(request.resource.data.get('followingId', ''), request.auth.uid);
      allow delete: if signedIn() && (resource.data.get('followerId', '') == request.auth.uid || resource.data.get('followingId', '') == request.auth.uid);
      allow update: if false;
    }

    match /reports/{reportId} {
      allow create: if signedIn() && request.resource.data.get('reporterId', '') == request.auth.uid &&
        request.resource.data.get('targetUserId', '') != request.auth.uid &&
        request.resource.data.get('status', '') == 'pending' &&
        request.resource.data.get('reason', '') in ['Spam', 'Harassment', 'Inappropriate / Sexual Content', 'Violence', 'False Information'] &&
        ((request.resource.data.get('streamId', null) == null && reportId == 'profile_' + request.resource.data.get('targetUserId', '') + '_' + request.auth.uid) ||
          (request.resource.data.get('streamId', '') is string &&
            reportId == request.resource.data.get('streamId', '') + '_' + request.auth.uid &&
            get(/databases/$(database)/documents/liveStreams/$(request.resource.data.get('streamId', ''))).data.get('hostId', '') == request.resource.data.get('targetUserId', '')));
      allow get: if signedIn() && (!exists(/databases/$(database)/documents/reports/$(reportId)) || resource.data.get('reporterId', '') == request.auth.uid || isAdmin());
      allow list: if isAdmin();
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /blocks/{blockId} {
      allow get: if signedIn() && (!exists(/databases/$(database)/documents/blocks/$(blockId)) || resource.data.get('blockerId', '') == request.auth.uid || resource.data.get('blockedId', '') == request.auth.uid);
      allow list: if signedIn() && (resource.data.get('blockerId', '') == request.auth.uid || resource.data.get('blockedId', '') == request.auth.uid);
      allow create: if signedIn() && request.resource.data.get('blockerId', '') == request.auth.uid &&
        request.resource.data.get('blockedId', '') != request.auth.uid &&
        blockId == request.auth.uid + '_' + request.resource.data.get('blockedId', '');
      allow delete: if signedIn() && resource.data.get('blockerId', '') == request.auth.uid;
      allow update: if false;
    }

    match /liveTimeouts/{timeoutId} {
      allow read: if signedIn() && (resource.data.get('userId', '') == request.auth.uid || resource.data.get('hostId', '') == request.auth.uid || isAdmin());
      allow create: if signedIn() && request.resource.data.get('userId', '') != request.auth.uid &&
        timeoutId == request.resource.data.get('streamId', '') + '_' + request.resource.data.get('userId', '') &&
        liveHost(request.resource.data.get('streamId', '')) == request.auth.uid &&
        request.resource.data.get('expiresAt', 0) > request.time.toMillis() &&
        request.resource.data.get('expiresAt', 0) <= request.time.toMillis() + 86400000;
      allow delete: if signedIn() && resource.data.get('hostId', '') == request.auth.uid;
      allow update: if signedIn() && resource.data.get('hostId', '') == request.auth.uid &&
        request.resource.data.get('hostId', '') == request.auth.uid &&
        request.resource.data.get('streamId', '') == resource.data.get('streamId', '') &&
        request.resource.data.get('userId', '') == resource.data.get('userId', '') &&
        request.resource.data.get('expiresAt', 0) > request.time.toMillis() &&
        request.resource.data.get('expiresAt', 0) <= request.time.toMillis() + 86400000;
    }

    // V2 online Ludo rooms: room participants can read live board state. A new
    // player may join only a waiting room, and no more than four players may join.
    match /v2LudoGames/{roomId} {
      allow read: if signedIn();
      allow create: if signedIn() &&
        request.resource.data.get('hostId', '') == request.auth.uid &&
        request.resource.data.get('playerIds', []).size() == 1 &&
        request.resource.data.get('playerIds', []).hasAll([request.auth.uid]) &&
        request.resource.data.get('status', '') == 'waiting';
      allow update: if signedIn() && (
        (request.auth.uid in resource.data.get('playerIds', []) &&
          request.resource.data.get('playerIds', []) == resource.data.get('playerIds', []) &&
          request.resource.data.get('hostId', '') == resource.data.get('hostId', '') &&
          request.resource.data.get('players', []).size() == resource.data.get('players', []).size() &&
          request.resource.data.get('players', []).size() <= 4 &&
          request.resource.data.get('turn', 0) >= 0 &&
          request.resource.data.get('turn', 0) < request.resource.data.get('players', []).size()) ||
        (resource.data.get('status', '') == 'waiting' &&
          request.resource.data.get('playerIds', []).size() == resource.data.get('playerIds', []).size() + 1 &&
          request.resource.data.get('playerIds', []).size() <= 4 &&
          request.resource.data.get('playerIds', []).hasAll(resource.data.get('playerIds', [])) &&
          request.resource.data.get('playerIds', []).hasAll([request.auth.uid]) &&
          request.resource.data.get('hostId', '') == resource.data.get('hostId', '') &&
          request.resource.data.get('players', []).size() == request.resource.data.get('playerIds', []).size()));
      allow delete: if signedIn() && resource.data.get('hostId', '') == request.auth.uid;
    }
  }
}
