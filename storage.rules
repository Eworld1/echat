rules_version = '2';
// Firebase Storage rules for Reels / Stories media.
// Anyone may view media (it is referenced by public reels); only the owner may upload into their
// own folder, and videos are limited to 30 MB and photos to 10 MB, in the allowed formats only.
service firebase.storage {
  match /b/{bucket}/o {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function allowedMedia() {
      return (request.resource.contentType.matches('video/(mp4|quicktime|webm)') && request.resource.size <= 30 * 1024 * 1024) ||
        (request.resource.contentType.matches('image/(jpeg|png|webp)') && request.resource.size <= 10 * 1024 * 1024);
    }

    match /reels/{uid}/{fileName} {
      allow read: if true;
      allow create: if isOwner(uid) && allowedMedia();
      allow delete: if isOwner(uid);
    }
    match /stories/{uid}/{fileName} {
      allow read: if true;
      allow create: if isOwner(uid) && allowedMedia();
      allow delete: if isOwner(uid);
    }
    match /covers/{uid}/{fileName} {
      allow read: if true;
      allow create: if isOwner(uid) && request.resource.size <= 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if isOwner(uid);
    }
  }
}
